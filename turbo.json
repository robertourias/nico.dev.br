{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_PORTFOLIO_URL",
    "NEXT_PUBLIC_PORTFOLIO_LABEL",
    "NEXT_PUBLIC_CHALLENGES_URL",
    "NEXT_PUBLIC_CHALLENGES_LABEL",
    "NEXT_PUBLIC_BLOG_URL",
    "NEXT_PUBLIC_BLOG_LABEL",
    "NEXT_PUBLIC_TOOLS_URL",
    "NEXT_PUBLIC_TOOLS_LABEL",
    "NEXT_PUBLIC_METRONOME_URL",
    "NEXT_PUBLIC_METRONOME_LABEL",
    "NEXT_PUBLIC_CRIATIVO_URL",
    "NEXT_PUBLIC_CRIATIVO_LABEL",
    "NEXT_PUBLIC_SKILLS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
