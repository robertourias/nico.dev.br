# apps/api — backend NestJS (claps do blog). Postgres e Redis ficam na rede Docker
# interna da VPS, nunca expostos publicamente. Ver docs/specs/2026-06-25-api-claps-backend.md (raiz).

# Local (docker-compose.yml deste app): postgres://api:api@localhost:5432/api_claps
# Produção (VPS): connection string usando o nome do serviço Docker, ex.
#   postgres://<user>:<senha>@postgres:5432/<db>
DATABASE_URL=postgres://api:api@localhost:5432/api_claps

# Local: redis://localhost:6379
# Produção (VPS): redis://redis:6379 (nome do serviço Docker), ou com senha:
#   redis://:<senha>@redis:6379
REDIS_URL=redis://localhost:6379

# Secret compartilhado com apps/blog (header X-Internal-Secret). Gerar um valor forte
# (ex.: `openssl rand -hex 32`) e usar O MESMO valor nos dois lados (Vercel + VPS).
CLAPS_API_SECRET=changeme

PORT=3001
NODE_ENV=development
      
      
