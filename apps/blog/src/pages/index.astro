---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import { BlogHome } from '@/components/BlogHome';
import { readingTime } from '@/utils/readingTime';
import { CATEGORY_LABELS } from '@/types/post';
import { SITE } from '@/config';

const allEntries = await getCollection('posts', ({ data }) => data.status === 'published');

const sorted = allEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const posts = sorted.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  category: entry.data.category,
  date: entry.data.date,
  slug: entry.data.slug,
  readingTimeMinutes: readingTime(entry.body ?? ''),
}));

const categories = (Object.keys(CATEGORY_LABELS) as Array<keyof typeof CATEGORY_LABELS>)
  .map((name) => ({
    name,
    label: CATEGORY_LABELS[name],
    count: posts.filter((p) => p.category === name).length,
  }))
  .filter((cat) => cat.count > 0);

const featuredPosts = sorted
  .filter((entry) => entry.data.featured)
  .map((entry) => ({ title: entry.data.title, slug: entry.data.slug }));
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Header />
  <BlogHome
    client:load
    posts={posts}
    categories={categories}
    featuredPosts={featuredPosts}
  />
</BaseLayout>
