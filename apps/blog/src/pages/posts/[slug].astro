---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ImmersivePostLayout from '@/layouts/ImmersivePostLayout.astro';
import { BlogHeader } from '@/components/BlogHeader';
import { PostSidebar } from '@/components/PostSidebar';
import { mdxComponents } from '@/content/mdx-components';
import { readingTime } from '@/utils/readingTime';
import { CATEGORY_LABELS } from '@/types/post';
import { ClapButton } from '@/components/ClapButton';
import { ShareButton } from '@/components/ShareButton';
import { ArrowLeft } from 'lucide-react';

export async function getStaticPaths() {
  const allEntries = await getCollection('posts', ({ data }) => data.status === 'published');

  const categoryNames = Object.keys(CATEGORY_LABELS) as Array<keyof typeof CATEGORY_LABELS>;

  return allEntries.map((post) => {
    const categories = categoryNames
      .map((name) => ({
        name,
        label: CATEGORY_LABELS[name],
        count: allEntries.filter((e) => e.data.category === name).length,
      }))
      .filter((c) => c.count > 0);

    const featuredPosts = allEntries
      .filter((e) => e.data.featured)
      .map((e) => ({ title: e.data.title, slug: e.data.slug }));

    const tagCounts = new Map<string, number>();
    for (const entry of allEntries) {
      for (const tag of entry.data.tags ?? []) {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
      }
    }
    const allTags = [...tagCounts.entries()]
      .sort((a, b) => b[1] - a[1])
      .map(([tag, count]) => ({ tag, count }));

    return {
      params: { slug: post.data.slug },
      props: { post, categories, featuredPosts, allTags },
    };
  });
}

const { post, categories, featuredPosts, allTags } = Astro.props;
const { Content } = await render(post);

const {
  title,
  description,
  date,
  category,
  tags,
  coverImage,
  template,
  heroImage,
  slug,
} = post.data;

const formattedDate = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const readTime = readingTime(post.body ?? '');
const categoryLabel = CATEGORY_LABELS[category] ?? category;
const isImmersive = template === 'immersive';
const socialImage = coverImage ?? heroImage;
---

{isImmersive ? (
  <ImmersivePostLayout
    {title}
    {description}
    {date}
    {category}
    {tags}
    {heroImage}
    {readTime}
    {categoryLabel}
    {slug}
  >
    <Content components={mdxComponents} />
  </ImmersivePostLayout>
) : (
  <BaseLayout
    {title}
    {description}
    type="article"
    image={socialImage}
    publishedTime={date.toISOString()}
  >
    <BlogHeader client:load />
    <PostSidebar client:load {categories} {featuredPosts} {allTags} />

    <div class="max-w-[70ch] mx-auto px-6 py-12 lg:py-16">
      <!-- Voltar -->
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm mb-8 transition-colors"
        style="color: var(--color-text-body);"
      >
        <ArrowLeft size={14} />
        Todos os posts
      </a>

      <!-- Cabeçalho do post -->
      <header class="mb-8">
        <!-- Categoria + tempo de leitura -->
        <div class="flex items-center gap-3 mb-4">
          <span
            class="text-xs font-medium uppercase tracking-wide"
            style="color: var(--color-text-highlight);"
          >
            {categoryLabel}
          </span>
          <span class="text-xs" style="color: var(--color-text-body);">
            {readTime} min de leitura
          </span>
        </div>

        <!-- Título -->
        <h1
          class="font-heading text-4xl font-semibold leading-tight mb-5"
          style="color: var(--color-text-heading);"
        >
          {title}
        </h1>

        <!-- Descrição -->
        <p
          class="text-lg leading-relaxed mb-6"
          style="color: var(--color-text-body);"
        >
          {description}
        </p>

        <!-- Clap + share + data + tags -->
        <div class="flex flex-wrap items-center gap-2">
          <ClapButton client:visible slug={slug} />
          <ShareButton client:visible title={title} text={description} url={`/posts/${slug}`} />

          <span style="color: var(--color-border);">·</span>

          <time
            class="text-xs"
            style="color: var(--color-text-body);"
            datetime={date.toISOString()}
          >
            {formattedDate}
          </time>

          {tags.length > 0 && (
            <>
              <span style="color: var(--color-border);">·</span>
              {tags.map((tag) => (
                <span
                  class="text-xs px-2 py-0.5 rounded-full border"
                  style="color: var(--color-text-body); border-color: var(--color-border);"
                >
                  #{tag}
                </span>
              ))}
            </>
          )}
        </div>
      </header>

      <!-- Separador -->
      <hr style="border-color: var(--color-border);" class="mb-8" />

      <!-- Cover image -->
      {coverImage && (
        <figure class="mb-10 -mx-6 lg:mx-0">
          <img
            src={coverImage}
            alt={`Imagem de capa: ${title}`}
            class="w-full object-cover rounded-card"
            style="aspect-ratio: 16/9; border: 1px solid var(--color-border);"
            loading="eager"
          />
        </figure>
      )}

      <!-- Conteúdo do post — prose styles via global.css (.post-content) -->
      <article class="post-content">
        <Content components={mdxComponents} />
      </article>

      <!-- Footer -->
      <footer class="mt-12 pt-8 border-t" style="border-color: var(--color-border);">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm transition-colors"
          style="color: var(--color-text-body);"
        >
          <ArrowLeft size={14} />
          Todos os posts
        </a>
      </footer>
    </div>
  </BaseLayout>
)}
