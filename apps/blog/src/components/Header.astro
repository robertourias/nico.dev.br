---
import { Github, Linkedin, Twitter, Menu } from 'lucide-react';
import { ThemeToggle } from '@/components/ThemeToggle';
import { SITE, SOCIAL } from '@/config';
---

<header
  class="sticky top-0 z-50 flex items-center px-4 h-14 gap-3 backdrop-blur-md border-b"
  style="background-color: color-mix(in srgb, var(--color-bg) 85%, transparent); border-color: var(--color-border);"
>
  <!-- Hamburger — só mobile, à esquerda -->
  <button
    id="sidebar-toggle"
    aria-label="Abrir menu de categorias"
    class="lg:hidden flex items-center justify-center w-9 h-9 rounded-lg transition-colors shrink-0"
    style="color: var(--color-text-body);"
  >
    <Menu size={18} />
  </button>

  <!-- Logo -->
  <a
    href="/"
    class="font-heading font-semibold text-sm tracking-tight shrink-0"
    style="color: var(--color-text-heading);"
  >
    {SITE.name}
  </a>

  <!-- Espaçador -->
  <div class="flex-1" />

  <!-- Links de navegação — ocultos no mobile -->
  <nav class="hidden sm:flex items-center gap-1">
    <a
      href="https://nico.dev.br/"
      class="px-3 py-1.5 text-xs rounded-lg transition-colors"
      style="color: var(--color-text-body);"
    >
      nico.dev.br
    </a>
    <a
      href="https://tools.nico.dev.br/"
      class="px-3 py-1.5 text-xs rounded-lg transition-colors"
      style="color: var(--color-text-body);"
    >
      tools
    </a>
  </nav>

  <div class="w-px h-4 shrink-0" style="background-color: var(--color-border);"></div>

  <!-- Links sociais -->
  <div class="flex items-center gap-1">
    <a
      href={SOCIAL.github}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="flex items-center justify-center w-9 h-9 rounded-lg transition-colors"
      style="color: var(--color-text-body);"
    >
      <Github size={18} />
    </a>
    <a
      href={SOCIAL.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="flex items-center justify-center w-9 h-9 rounded-lg transition-colors"
      style="color: var(--color-text-body);"
    >
      <Linkedin size={18} />
    </a>
    <a
      href={SOCIAL.twitter}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Twitter"
      class="flex items-center justify-center w-9 h-9 rounded-lg transition-colors"
      style="color: var(--color-text-body);"
    >
      <Twitter size={18} />
    </a>

    <div class="w-px h-4 mx-1 shrink-0" style="background-color: var(--color-border);"></div>

    <!-- Toggle de tema -->
    <ThemeToggle client:load />
  </div>
</header>

<script>
  document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-sidebar'));
  });
</script>
