---
import '@/styles/global.css';
import { SITE } from '@/config';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  /** Absolute or site-relative image URL for social previews (og:image / twitter:image). */
  image?: string;
  /** Open Graph type. Posts should use "article". */
  type?: 'website' | 'article';
  /** ISO date string for article:published_time when type is article. */
  publishedTime?: string;
}

const {
  title,
  description,
  canonicalUrl,
  image,
  type = 'website',
  publishedTime,
} = Astro.props;

const siteUrl = SITE.url;
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
const pageTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;

function toAbsoluteUrl(pathOrUrl: string): string {
  if (pathOrUrl.startsWith('http://') || pathOrUrl.startsWith('https://')) {
    return pathOrUrl;
  }
  return `${siteUrl}${pathOrUrl.startsWith('/') ? '' : '/'}${pathOrUrl}`;
}

const ogImage = image ? toAbsoluteUrl(image) : undefined;
const twitterCard = ogImage ? 'summary_large_image' : 'summary';
---

<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook, Discord, etc.) -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Anti-FOUC: blog é dark-default. Remove .dark só se usuário escolheu light. -->
    <script is:inline>
      (function () {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
